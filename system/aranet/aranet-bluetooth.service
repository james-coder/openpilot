[Unit]
Description=Optional passive cabin Bluetooth receiver (no vehicle control)
After=multi-user.target

[Service]
Type=simple
User=root
Group=comma
WorkingDirectory=/data/openpilot
Environment=PYTHONPATH=/data/openpilot
ExecStart=/usr/local/venv/bin/python -m openpilot.system.aranet.bluetooth
RuntimeDirectory=aranet-bluetooth
RuntimeDirectoryMode=0750
LogsDirectory=aranet-bluetooth
LogsDirectoryMode=0750
Restart=on-failure
RestartSec=30
Nice=19
CPUSchedulingPolicy=idle
IOSchedulingClass=idle
MemoryMax=128M
CPUQuota=5%
KillMode=control-group
TimeoutStopSec=10
NoNewPrivileges=true
RestrictAddressFamilies=AF_UNIX AF_BLUETOOTH AF_NETLINK
ProtectSystem=full
ProtectHome=true
ReadOnlyPaths=/data/aranet /data/aranet-bluetooth
StandardOutput=null
StandardError=null

[Install]
WantedBy=multi-user.target
