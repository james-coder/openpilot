[Unit]
Description=Optional passive cabin Bluetooth receiver (no vehicle control)
After=local-fs.target

[Service]
Type=simple
User=root
Group=comma
# msgq subscribers may create shared files before publishers at boot. Preserve
# group write access so comma-user driving processes can open them O_RDWR.
UMask=0002
WorkingDirectory=/data/openpilot
Environment=PYTHONPATH=/data/openpilot
ExecStart=/usr/local/venv/bin/python -m openpilot.system.aranet.bluetooth
RuntimeDirectory=aranet-bluetooth
RuntimeDirectoryMode=0750
LogsDirectory=aranet-bluetooth
LogsDirectoryMode=0750
Restart=always
RestartSec=10
Nice=19
CPUSchedulingPolicy=idle
IOSchedulingClass=idle
MemoryMax=128M
CPUQuota=5%
CPUAccounting=true
KillMode=mixed
TimeoutStopSec=10
NoNewPrivileges=true
RestrictAddressFamilies=AF_UNIX AF_BLUETOOTH AF_NETLINK
ProtectSystem=full
ProtectHome=true
ReadOnlyPaths=/data/aranet /data/aranet-bluetooth
StandardOutput=journal
StandardError=journal

[Install]
WantedBy=multi-user.target
