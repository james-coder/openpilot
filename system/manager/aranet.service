[Unit]
Description=Passive Aranet4 cabin history (no vehicle control)
After=local-fs.target

[Service]
Type=simple
User=comma
Group=comma
WorkingDirectory=/data/openpilot
Environment=PYTHONPATH=/data/openpilot
ExecStart=/usr/local/venv/bin/python -m openpilot.selfdrive.car.aranet
Restart=always
RestartSec=10
Nice=19
CPUSchedulingPolicy=idle
IOSchedulingClass=idle
MemoryMax=96M
CPUQuota=5%
CPUAccounting=true
NoNewPrivileges=true
CapabilityBoundingSet=
RestrictAddressFamilies=AF_UNIX
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/data/aranet
UMask=0022
StandardOutput=journal
StandardError=journal
KillMode=mixed

[Install]
WantedBy=multi-user.target
