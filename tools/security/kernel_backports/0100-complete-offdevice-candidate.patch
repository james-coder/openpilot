new file mode 100644
index 00000000..429b7dec
--- /dev/null
+++ b/drivers/usb/core/modem-policy.c
@@ -0,0 +1,87 @@
+/* SPDX-License-Identifier: GPL-2.0 */
+/* Off-device C3X candidate. Physical-host restriction, NOT authentication.
+ * Legitimate option/QMI traffic and pre-policy USB core remain attackable.
+ */
+#include <linux/of.h>
+#include <linux/usb.h>
+#include "usb.h"
+
+static const u8 modem_device_desc[] = {
+	0x12, 0x01, 0x00, 0x02, 0xef, 0x02, 0x01, 0x40, 0x7c, 0x2c, 0x25, 0x01,
+	0x18, 0x03, 0x01, 0x02, 0x00, 0x01,
+};
+
+static const u8 modem_config_desc[] = {
+	0x09, 0x02, 0xd1, 0x00, 0x05, 0x01, 0x00, 0xa0, 0xfa, 0x09, 0x04, 0x00,
+	0x00, 0x02, 0xff, 0xff, 0xff, 0x00, 0x07, 0x05, 0x81, 0x02, 0x00, 0x02,
+	0x00, 0x07, 0x05, 0x01, 0x02, 0x00, 0x02, 0x00, 0x09, 0x04, 0x01, 0x00,
+	0x03, 0xff, 0x00, 0x00, 0x00, 0x05, 0x24, 0x00, 0x10, 0x01, 0x05, 0x24,
+	0x01, 0x00, 0x00, 0x04, 0x24, 0x02, 0x02, 0x05, 0x24, 0x06, 0x00, 0x00,
+	0x07, 0x05, 0x83, 0x03, 0x0a, 0x00, 0x09, 0x07, 0x05, 0x82, 0x02, 0x00,
+	0x02, 0x00, 0x07, 0x05, 0x02, 0x02, 0x00, 0x02, 0x00, 0x09, 0x04, 0x02,
+	0x00, 0x03, 0xff, 0x00, 0x00, 0x00, 0x05, 0x24, 0x00, 0x10, 0x01, 0x05,
+	0x24, 0x01, 0x00, 0x00, 0x04, 0x24, 0x02, 0x02, 0x05, 0x24, 0x06, 0x00,
+	0x00, 0x07, 0x05, 0x85, 0x03, 0x0a, 0x00, 0x09, 0x07, 0x05, 0x84, 0x02,
+	0x00, 0x02, 0x00, 0x07, 0x05, 0x03, 0x02, 0x00, 0x02, 0x00, 0x09, 0x04,
+	0x03, 0x00, 0x03, 0xff, 0x00, 0x00, 0x00, 0x05, 0x24, 0x00, 0x10, 0x01,
+	0x05, 0x24, 0x01, 0x00, 0x00, 0x04, 0x24, 0x02, 0x02, 0x05, 0x24, 0x06,
+	0x00, 0x00, 0x07, 0x05, 0x87, 0x03, 0x0a, 0x00, 0x09, 0x07, 0x05, 0x86,
+	0x02, 0x00, 0x02, 0x00, 0x07, 0x05, 0x04, 0x02, 0x00, 0x02, 0x00, 0x09,
+	0x04, 0x04, 0x00, 0x03, 0xff, 0xff, 0xff, 0x00, 0x07, 0x05, 0x89, 0x03,
+	0x08, 0x00, 0x09, 0x07, 0x05, 0x88, 0x02, 0x00, 0x02, 0x00, 0x07, 0x05,
+	0x05, 0x02, 0x00, 0x02, 0x00,
+};
+
+bool usb_modem_host(struct device *controller)
+{
+	struct device *dev;
+
+	for (dev = controller; dev; dev = dev->parent)
+		if (of_property_read_bool(dev->of_node,
+					  "comma,untrusted-modem-host"))
+			return true;
+	return false;
+}
+
+bool usb_modem_device(struct usb_device *dev)
+{
+	return dev->parent && usb_modem_host(dev->bus->controller);
+}
+
+bool usb_modem_profile(struct usb_device *dev)
+{
+	/* Root hubs and other controllers retain their original policy. */
+	if (!usb_modem_device(dev))
+		return true;
+	if (dev->parent->parent || dev->portnum != 1 ||
+	    dev->speed != USB_SPEED_HIGH ||
+	    memcmp(&dev->descriptor, modem_device_desc,
+		   sizeof(modem_device_desc)) ||
+	    !dev->config || !dev->rawdescriptors || !dev->rawdescriptors[0] ||
+	    le16_to_cpu(dev->config[0].desc.wTotalLength) !=
+		    sizeof(modem_config_desc))
+		return false;
+	/* Parsed total length is bounded by the actual returned buffer in
+	 * usb_parse_configuration(), not just its claimed wTotalLength.
+	 */
+	return !memcmp(dev->rawdescriptors[0], modem_config_desc,
+		       sizeof(modem_config_desc));
+}
+
+bool usb_modem_driver_allowed(struct usb_device *dev,
+			     struct usb_interface *intf,
+			     struct usb_driver *driver)
+{
+	unsigned int n;
+
+	if (!usb_modem_device(dev))
+		return true;
+	if (!dev->authorized || !usb_modem_profile(dev) ||
+	    !intf->authorized || intf->num_altsetting != 1 ||
+	    intf->cur_altsetting->desc.bAlternateSetting != 0)
+		return false;
+	n = intf->cur_altsetting->desc.bInterfaceNumber;
+	return (n < 4 && !strcmp(driver->name, "option")) ||
+	       (n == 4 && !strcmp(driver->name, "qmi_wwan"));
+}
